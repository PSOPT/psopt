@PACKAGE_INIT@

# PSOPT package config. Re-finds PSOPT's public dependencies so downstream
# consumers only need find_package(PSOPT) + link PSOPT::psopt.
include(CMakeFindDependencyMacro)

# module path so our bundled Find modules (FindIPOPT, Findadolc, ...) resolve
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

find_dependency(Eigen3)
find_dependency(IPOPT)
find_dependency(adolc)

set(PSOPT_WITH_CASADI @PSOPT_WITH_CASADI@)
if(PSOPT_WITH_CASADI)
  find_dependency(casadi)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/PSOPTTargets.cmake")

check_required_components(PSOPT)
